---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
const photo = `${base}samay.jpg`;

const socials = [
	{
		label: 'Email',
		href: `mailto:${site.email}`,
		external: false,
		icon: 'mail',
	},
	{
		label: 'LinkedIn',
		href: site.links.linkedin,
		external: true,
		icon: 'linkedin',
	},
	{
		label: 'GitHub',
		href: site.links.github,
		external: true,
		icon: 'github',
	},
	{
		label: 'X',
		href: site.links.x,
		external: true,
		icon: 'x',
	},
] as const;
---

<section class="hero" aria-label="Introduction">
	<div class="hero-inner">
		<div class="hero-copy">
			<h1>{site.name}</h1>
			<div class="intro">
				{site.intro.map((paragraph) => <p class="text-secondary">{paragraph}</p>)}
			</div>
			<div class="actions">
				{
					socials.map((item) => (
						<a
							class="icon-btn"
							href={item.href}
							aria-label={item.label}
							title={item.label}
							{...(item.external ? { target: '_blank', rel: 'noreferrer' } : {})}
						>
							{item.icon === 'mail' && (
								<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
									<path
										fill="currentColor"
										d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2Zm0 4-8 5L4 8V6l8 5 8-5v2Z"
									/>
								</svg>
							)}
							{item.icon === 'linkedin' && (
								<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
									<path
										fill="currentColor"
										d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0Z"
									/>
								</svg>
							)}
							{item.icon === 'github' && (
								<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
									<path
										fill="currentColor"
										d="M12 .3a12 12 0 0 0-3.79 23.4c.6.11.82-.26.82-.58v-2.02c-3.34.73-4.04-1.61-4.04-1.61-.55-1.4-1.34-1.77-1.34-1.77-1.1-.75.08-.74.08-.74 1.21.09 1.85 1.25 1.85 1.25 1.08 1.84 2.83 1.31 3.52 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.82.58A12 12 0 0 0 12 .3Z"
									/>
								</svg>
							)}
							{item.icon === 'x' && (
								<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
									<path
										fill="currentColor"
										d="M18.24 2H21l-6.52 7.46L22 22h-6.17l-4.83-6.31L5.35 22H2.58l6.97-7.97L2 2h6.33l4.36 5.77L18.24 2Zm-1.08 18.1h1.7L7.01 3.8H5.18l11.98 16.3Z"
									/>
								</svg>
							)}
						</a>
					))
				}
			</div>
		</div>

		<figure class="hero-photo">
			<img
				src={photo}
				alt={`${site.name} — portrait`}
				width="640"
				height="800"
				fetchpriority="high"
			/>
		</figure>
	</div>
</section>

<style>
	.hero {
		width: 100%;
		padding: 4rem 0 3rem;
	}

	.hero-inner {
		width: 100%;
		padding-inline: clamp(1.25rem, 4vw, 3.5rem);
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: start;
		column-gap: clamp(1.5rem, 4vw, 3.5rem);
	}

	.hero-copy {
		min-width: 0;
		width: 100%;
	}

	h1 {
		font-size: clamp(2.1rem, 4.5vw, 3.5rem);
		font-weight: 650;
		letter-spacing: -0.045em;
		line-height: 1.06;
		margin: 0;
		text-wrap: balance;
	}

	.intro {
		margin: 1.35rem 0 0;
		display: grid;
		gap: 1.1rem;
		max-width: 46rem;
	}

	.intro p {
		margin: 0;
		font-size: clamp(0.95rem, 1.45vw, 1.0625rem);
		line-height: 1.65;
		letter-spacing: -0.015em;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.95rem;
		margin-top: 2rem;
	}

	.icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.65rem;
		height: 2.65rem;
		border-radius: 999px;
		border: 1px solid var(--color-border-strong);
		color: var(--color-fg);
		background: transparent;
		transition:
			background 160ms ease,
			border-color 160ms ease,
			color 160ms ease,
			transform 160ms ease;
	}

	.icon-btn:hover {
		background: var(--color-bg-elevated);
		border-color: var(--color-fg-tertiary);
	}

	.icon-btn:active {
		transform: scale(0.96);
	}

	.hero-photo {
		margin: 0;
		width: clamp(180px, 28vw, 340px);
		border-radius: 1.15rem;
		overflow: hidden;
		background: #d8d2c8;
		aspect-ratio: 4 / 5;
		align-self: start;
		flex-shrink: 0;
	}

	.hero-photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 18%;
	}

	@media (min-width: 768px) {
		.hero {
			padding: 5.5rem 0 4rem;
		}

		.hero-inner {
			column-gap: clamp(2.5rem, 5vw, 4.5rem);
		}
	}
</style>
