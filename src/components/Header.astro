---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href={base}>Welcome</a>

		<nav class="nav" id="primary-nav" aria-label="Primary">
			{
				site.nav.map((item) => (
					<a href={item.href}>{item.label}</a>
				))
			}
		</nav>

		<div class="header-actions">
			<button
				type="button"
				class="menu-toggle"
				id="menu-toggle"
				aria-label="Open menu"
				aria-controls="primary-nav"
				aria-expanded="false"
			>
				<span class="menu-bars" aria-hidden="true"></span>
			</button>

			<button
				type="button"
				class="theme-toggle"
				id="theme-toggle"
				aria-label="Toggle color theme"
				title="Toggle theme"
			>
				<span class="icon icon-sun" aria-hidden="true">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
						<circle cx="12" cy="12" r="4"></circle>
						<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
					</svg>
				</span>
				<span class="icon icon-moon" aria-hidden="true">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
						<path d="M21 14.5A8.5 8.5 0 1 1 9.5 3a7 7 0 0 0 11.5 11.5z"></path>
					</svg>
				</span>
			</button>
		</div>
	</div>
</header>

<script>
	const root = document.documentElement;
	const button = document.getElementById('theme-toggle');
	const menuToggle = document.getElementById('menu-toggle');
	const nav = document.getElementById('primary-nav');

	function setTheme(theme: 'light' | 'dark') {
		root.setAttribute('data-theme', theme);
		localStorage.setItem('theme', theme);
	}

	function setMenu(open: boolean) {
		root.classList.toggle('nav-open', open);
		menuToggle?.setAttribute('aria-expanded', String(open));
		menuToggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
	}

	button?.addEventListener('click', () => {
		const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
		setTheme(next);
	});

	menuToggle?.addEventListener('click', () => {
		setMenu(!root.classList.contains('nav-open'));
	});

	nav?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setMenu(false));
	});

	window.matchMedia('(min-width: 900px)').addEventListener('change', (event) => {
		if (event.matches) setMenu(false);
	});
</script>

<style is:global>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: saturate(180%) blur(20px);
		-webkit-backdrop-filter: saturate(180%) blur(20px);
		background: var(--color-nav);
		border-bottom: 1px solid var(--color-border);
		padding-top: env(safe-area-inset-top);
	}

	.header-inner {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		height: 3.25rem;
		width: 100%;
		max-width: 72rem;
		margin-inline: auto;
		padding-inline: max(clamp(1.25rem, 4vw, 3.5rem), env(safe-area-inset-left))
			max(clamp(1.25rem, 4vw, 3.5rem), env(safe-area-inset-right));
	}

	.brand {
		font-family: var(--font-script);
		font-size: 1.65rem;
		font-weight: 400;
		letter-spacing: 0.01em;
		line-height: 1;
		margin-right: auto;
		padding-top: 0.15rem;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nav {
		display: none;
	}

	.nav a {
		font-size: 0.8125rem;
		color: var(--color-fg-secondary);
		transition: color 160ms ease;
	}

	.nav a:hover {
		color: var(--color-fg);
	}

	.menu-toggle,
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--color-border-strong);
		border-radius: 999px;
		background: transparent;
		color: var(--color-fg-secondary);
		cursor: pointer;
		transition:
			color 160ms ease,
			border-color 160ms ease,
			background 160ms ease;
	}

	.menu-toggle:hover,
	.theme-toggle:hover {
		color: var(--color-fg);
		background: var(--color-bg-elevated);
	}

	.menu-bars,
	.menu-bars::before,
	.menu-bars::after {
		display: block;
		width: 1rem;
		height: 1.5px;
		border-radius: 999px;
		background: currentColor;
		transition: transform 160ms ease, opacity 160ms ease;
	}

	.menu-bars {
		position: relative;
	}

	.menu-bars::before,
	.menu-bars::after {
		content: '';
		position: absolute;
		left: 0;
	}

	.menu-bars::before {
		top: -5px;
	}

	.menu-bars::after {
		top: 5px;
	}

	html.nav-open .menu-bars {
		background: transparent;
	}

	html.nav-open .menu-bars::before {
		top: 0;
		transform: rotate(45deg);
	}

	html.nav-open .menu-bars::after {
		top: 0;
		transform: rotate(-45deg);
	}

	html[data-theme='light'] .icon-moon,
	html[data-theme='dark'] .icon-sun {
		display: none;
	}

	@media (max-width: 899px) {
		html.nav-open .nav {
			display: flex;
			flex-direction: column;
			gap: 0.15rem;
			position: absolute;
			top: calc(3.25rem + env(safe-area-inset-top));
			left: 0;
			right: 0;
			padding: 0.75rem max(clamp(1.25rem, 4vw, 3.5rem), env(safe-area-inset-left))
				1.1rem max(clamp(1.25rem, 4vw, 3.5rem), env(safe-area-inset-right));
			background: var(--color-nav);
			backdrop-filter: saturate(180%) blur(20px);
			-webkit-backdrop-filter: saturate(180%) blur(20px);
			border-bottom: 1px solid var(--color-border);
			box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
		}

		html.nav-open .nav a {
			display: block;
			padding: 0.7rem 0.15rem;
			font-size: 1rem;
			font-weight: 500;
			color: var(--color-fg);
		}
	}

	@media (min-width: 900px) {
		.menu-toggle {
			display: none;
		}

		.nav {
			display: flex;
			align-items: center;
			gap: clamp(0.85rem, 1.6vw, 1.35rem);
		}

		.theme-toggle {
			width: 2rem;
			height: 2rem;
		}
	}
</style>
