---
import { openSource, projects } from '../data/site';

const logoBase = `${import.meta.env.BASE_URL}logos/`;
const organizations = [
	{ name: 'Google', slug: 'google', logo: 'google.png' },
	{ name: 'OpenClaw', slug: 'openclaw', logo: 'openclaw.png' },
] as const;
---

<section id="open-source" class="section-pad">
	<div class="container-page">
		<div class="os-shell">
			<div class="os-title-row">
				<h2>Open-Source</h2>
				<div class="os-live-wrap">
					<p class="os-live" id="os-live" data-state="idle">
						<span class="os-dot"></span>
						<span id="os-live-text">Connecting</span>
					</p>
					<button class="os-refresh" id="os-refresh" type="button" aria-label="Refresh GitHub contributions" title="Refresh">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
							<path d="M20 11a8.1 8.1 0 1 0 2.2 5.5"></path>
							<path d="M20 4v7h-7"></path>
						</svg>
					</button>
				</div>
			</div>

			<div class="os-copy">
				<p class="os-belief">{openSource.belief}</p>
			</div>

			<div class="os-block">
				<h3 class="os-block-title">Organisations</h3>
				<div class="os-groups" data-user={openSource.githubUser}>
					{
						organizations.map((org, index) => {
							const pulls = openSource.fallback.filter((pull) => pull.org === org.name);
							return (
								<article class="os-group" data-org={org.slug}>
									<header class="os-org-head">
										<span class="os-index">{String(index + 1).padStart(2, '0')}</span>
										<img src={`${logoBase}${org.logo}`} alt="" width="40" height="40" />
										<div>
											<h4>{org.name}</h4>
											<p>
												<span data-count>{pulls.length}</span>{' '}
												{pulls.length === 1 ? 'contribution' : 'contributions'}
											</p>
										</div>
									</header>

									<ul class="os-prs" data-list>
										{pulls.map((pr) => (
											<li>
												<a class="os-pr" href={pr.href} target="_blank" rel="noreferrer">
													<span class="os-pr-copy">
														<span class="os-pr-title">{pr.title}</span>
														<span class="os-pr-meta">
															{pr.repo} · {pr.number}
														</span>
													</span>
													<span class:list={['os-status', pr.status.toLowerCase()]}>{pr.status}</span>
													<svg class="os-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
														<path d="M7 17 17 7M7 7h10v10"></path>
													</svg>
												</a>
											</li>
										))}
									</ul>
								</article>
							);
						})
					}
				</div>
			</div>

			<div class="os-block">
				<h3 class="os-block-title">Personal</h3>
				<ul class="os-personal os-prs">
					{
						projects.map((project) => (
							<li>
								<a class="os-pr os-pr-personal" href={project.href} target="_blank" rel="noreferrer">
									<span class="os-pr-copy">
										<span class="os-pr-title">{project.title}</span>
									</span>
									<svg class="os-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
										<path d="M7 17 17 7M7 7h10v10"></path>
									</svg>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>

<script>
	type Pull = {
		title: string;
		number: string;
		repo: string;
		status: string;
		href: string;
	};

	const groups = document.querySelector<HTMLElement>('.os-groups');
	const live = document.getElementById('os-live');
	const liveText = document.getElementById('os-live-text');
	const refresh = document.getElementById('os-refresh') as HTMLButtonElement | null;
	if (!groups) throw new Error('Open-source groups missing');

	const user = groups.dataset.user || 'Samay10';
	const cacheKey = `github-contributions-${user}`;

	function setLive(state: 'idle' | 'loading' | 'live' | 'cached' | 'offline', text: string) {
		live?.setAttribute('data-state', state);
		if (liveText) liveText.textContent = text;
	}

	function createPull(pull: Pull) {
		const li = document.createElement('li');
		const link = document.createElement('a');
		link.className = 'os-pr';
		link.href = pull.href;
		link.target = '_blank';
		link.rel = 'noreferrer';

		const copy = document.createElement('span');
		copy.className = 'os-pr-copy';
		const title = document.createElement('span');
		title.className = 'os-pr-title';
		title.textContent = pull.title;
		const meta = document.createElement('span');
		meta.className = 'os-pr-meta';
		meta.textContent = `${pull.repo} · ${pull.number}`;
		copy.append(title, meta);

		const status = document.createElement('span');
		status.className = `os-status ${pull.status.toLowerCase()}`;
		status.textContent = pull.status;

		const arrow = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
		arrow.setAttribute('class', 'os-arrow');
		arrow.setAttribute('width', '16');
		arrow.setAttribute('height', '16');
		arrow.setAttribute('viewBox', '0 0 24 24');
		arrow.setAttribute('fill', 'none');
		arrow.setAttribute('stroke', 'currentColor');
		arrow.setAttribute('stroke-width', '1.7');
		const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
		path.setAttribute('d', 'M7 17 17 7M7 7h10v10');
		arrow.append(path);

		link.append(copy, status, arrow);
		li.append(link);
		return li;
	}

	function render(org: string, pulls: Pull[]) {
		const group = groups?.querySelector<HTMLElement>(`[data-org="${org}"]`);
		const list = group?.querySelector<HTMLUListElement>('[data-list]');
		const count = group?.querySelector<HTMLElement>('[data-count]');
		const visible = pulls.filter((pull) => pull.status !== 'Closed');
		if (!list || !count || visible.length === 0) return;
		list.replaceChildren(...visible.map(createPull));
		count.textContent = String(visible.length);
		const label = count.nextSibling;
		if (label) label.textContent = visible.length === 1 ? ' contribution' : ' contributions';
	}

	async function fetchOrg(org: string, knownMerged: Set<string>): Promise<Pull[]> {
		const query = encodeURIComponent(`author:${user} type:pr org:${org}`);
		const response = await fetch(
			`https://api.github.com/search/issues?q=${query}&sort=updated&order=desc&per_page=10`,
			{ headers: { Accept: 'application/vnd.github+json' } },
		);
		if (!response.ok) throw new Error(`GitHub request failed for ${org}`);
		const payload = (await response.json()) as {
			items: Array<{
				title: string;
				number: number;
				html_url: string;
				state: string;
				pull_request?: { merged_at?: string | null };
				repository_url: string;
			}>;
		};

		return payload.items
			.map((item) => {
				const merged =
					Boolean(item.pull_request?.merged_at) || knownMerged.has(item.html_url);
				if (!merged && item.state !== 'open') return null;
				return {
					title: item.title,
					number: `#${item.number}`,
					repo: item.repository_url.split('/').pop() || org,
					status: merged ? 'Merged' : 'Open',
					href: item.html_url,
				};
			})
			.filter((item): item is Pull => item !== null);
	}

	function knownMergedPulls() {
		return new Set(
			[...groups!.querySelectorAll<HTMLAnchorElement>('.os-pr')]
				.filter((link) => link.querySelector('.os-status.merged'))
				.map((link) => link.href),
		);
	}

	async function loadLive(force = false) {
		setLive('loading', 'Updating');
		refresh?.classList.add('spinning');

		try {
			const cached = localStorage.getItem(cacheKey);
			if (!force && cached) {
				const data = JSON.parse(cached) as {
					at: number;
					google: Pull[];
					openclaw: Pull[];
				};
				if (Date.now() - data.at < 15 * 60 * 1000) {
					render('google', data.google);
					render('openclaw', data.openclaw);
					setLive('cached', 'Live · cached');
					return;
				}
			}

			const merged = knownMergedPulls();
			const [google, openclaw] = await Promise.all([
				fetchOrg('google', merged),
				fetchOrg('openclaw', merged),
			]);
			render('google', google);
			render('openclaw', openclaw);
			localStorage.setItem(cacheKey, JSON.stringify({ at: Date.now(), google, openclaw }));
			setLive('live', 'Live from GitHub');
		} catch {
			setLive('offline', 'Saved contributions');
		} finally {
			refresh?.classList.remove('spinning');
		}
	}

	refresh?.addEventListener('click', () => loadLive(true));
	loadLive();
</script>

<style is:global>
	.os-shell {
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--color-border);
		text-align: left;
	}

	.os-title-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin: 0 0 0.85rem;
	}

	.os-title-row h2 {
		font-size: clamp(1.35rem, 2.4vw, 1.75rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: var(--color-fg);
		margin: 0;
	}

	.os-live-wrap {
		display: flex;
		align-items: center;
		gap: 0.55rem;
	}

	.os-live {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-fg-tertiary);
	}

	.os-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: var(--color-fg-tertiary);
	}

	.os-live[data-state='live'] .os-dot,
	.os-live[data-state='cached'] .os-dot {
		background: #3fb950;
		box-shadow: 0 0 0 4px rgba(63, 185, 80, 0.16);
	}

	.os-refresh {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		padding: 0;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: transparent;
		color: var(--color-fg-tertiary);
		cursor: pointer;
	}

	.os-refresh:hover {
		color: var(--color-fg);
		background: var(--color-bg-elevated);
	}

	.os-refresh.spinning svg {
		animation: os-spin 0.75s linear infinite;
	}

	@keyframes os-spin {
		to {
			transform: rotate(360deg);
		}
	}

	.os-copy {
		padding-top: 1.15rem;
		border-top: 1px solid var(--color-border);
		max-width: 46rem;
	}

	.os-belief {
		margin: 0;
		font-size: 1.0625rem;
		font-weight: 450;
		line-height: 1.65;
		letter-spacing: -0.015em;
		color: var(--color-fg);
	}

	.os-block {
		margin-top: 1.75rem;
	}

	.os-block-title {
		margin: 0 0 0.85rem;
		font-size: 0.75rem;
		font-weight: 650;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-fg-tertiary);
	}

	.os-groups {
		display: grid;
		gap: 1.35rem;
	}

	.os-group {
		border-top: 1px solid var(--color-border);
	}

	.os-org-head {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 1rem 0 0.85rem;
	}

	.os-index {
		width: 1.5rem;
		font-size: 0.7rem;
		font-weight: 650;
		color: var(--color-fg-tertiary);
	}

	.os-org-head img {
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.55rem;
		object-fit: cover;
		background: #fff;
	}

	.os-org-head h4 {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.os-org-head p {
		margin: 0.1rem 0 0;
		font-size: 0.75rem;
		color: var(--color-fg-tertiary);
	}

	.os-prs {
		list-style: none;
		margin: 0;
		padding: 0 0 0 2.3rem;
	}

	.os-personal.os-prs {
		padding: 0;
		border-top: 1px solid var(--color-border);
	}

	.os-pr {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto 1rem;
		align-items: center;
		gap: 0.8rem;
		padding: 0.8rem 0.7rem;
		border-top: 1px solid var(--color-border);
		border-radius: 0.5rem;
		transition: background 140ms ease;
	}

	.os-pr-personal {
		grid-template-columns: minmax(0, 1fr) 1rem;
	}

	.os-pr:hover {
		background: var(--color-bg-elevated);
	}

	.os-pr-copy {
		min-width: 0;
		display: grid;
		gap: 0.15rem;
	}

	.os-pr-title {
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.os-pr-meta {
		font-size: 0.72rem;
		color: var(--color-fg-tertiary);
	}

	.os-status {
		display: inline-flex;
		align-items: center;
		height: 1.25rem;
		padding: 0 0.45rem;
		border-radius: 999px;
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.os-status.merged {
		background: rgba(163, 113, 247, 0.16);
		color: #c4a5ff;
	}

	.os-status.open {
		background: rgba(35, 134, 54, 0.16);
		color: #3fb950;
	}

	.os-status.closed {
		background: var(--color-border);
		color: var(--color-fg-tertiary);
	}

	html:not([data-theme='dark']) .os-status.merged {
		background: rgba(130, 80, 223, 0.12);
		color: #6e40c9;
	}

	html:not([data-theme='dark']) .os-status.open {
		background: rgba(26, 127, 55, 0.12);
		color: #1a7f37;
	}

	.os-arrow {
		color: var(--color-fg-tertiary);
		transition: transform 140ms ease;
	}

	.os-pr:hover .os-arrow {
		transform: translate(2px, -2px);
		color: var(--color-fg);
	}

	@media (min-width: 900px) {
		.os-groups {
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}
	}

	@media (max-width: 600px) {
		.os-live {
			display: none;
		}

		.os-prs {
			padding-left: 0;
		}

		.os-status {
			display: none;
		}
	}
</style>
