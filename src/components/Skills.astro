---
import { skills } from '../data/site';
---

<section id="skills" class="section-pad">
	<div class="container-page">
		<div class="sk-shell">
			<h2>Skills</h2>

			<ul class="sk-list">
				{
					skills.map((group) => (
						<li class="sk-row">
							<span class="sk-label">{group.label}</span>
							<p class="sk-items">{group.items.join(' · ')}</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.sk-shell {
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--color-border);
	}

	h2 {
		font-size: clamp(1.35rem, 2.4vw, 1.75rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: var(--color-fg);
		margin: 0 0 0.85rem;
	}

	.sk-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-border);
	}

	.sk-row {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr);
		column-gap: 2rem;
		align-items: baseline;
		padding: 1.15rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.sk-row:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.sk-label {
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--color-fg-tertiary);
	}

	.sk-items {
		margin: 0;
		max-width: 46rem;
		font-size: 0.975rem;
		font-weight: 450;
		line-height: 1.65;
		letter-spacing: -0.01em;
		color: var(--color-fg);
	}

	@media (max-width: 640px) {
		.sk-row {
			grid-template-columns: 1fr;
			row-gap: 0.35rem;
		}

		.sk-items {
			font-size: 0.95rem;
		}
	}
</style>
